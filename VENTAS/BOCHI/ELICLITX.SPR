#REGION 1
IF WVISIBLE("_7kp0oulzh")
	ACTIVATE WINDOW _7kp0oulzh SAME
ELSE
	ACTIVATE WINDOW _7kp0oulzh NOSHOW
ENDIF
@ 1.923,23.200 GET m.minimo ;
	SIZE 1.538,68.800 ;
	DEFAULT " " ;
	FONT "MS Sans Serif", 8 ;
	PICTURE "@K!"
@ 2.000,1.200 SAY "Desde Cliente" ;
	FONT "MS Sans Serif", 12 ;
	STYLE "T"
@ 4.308,69.600 GET m.nada ;
	PICTURE "@*HT OK" ;
	SIZE 1.769,9.167,0.667 ;
	DEFAULT 1 ;
	FONT "MS Sans Serif", 8 ;
	STYLE "B"

IF NOT WVISIBLE("_7kp0oulzh")
	ACTIVATE WINDOW _7kp0oulzh
ENDIF

READ CYCLE

RELEASE WINDOW _7kp0oulzh

#REGION 0

SET READBORDER &rborder

IF m.talkstat = "ON"
	SET TALK ON
ENDIF
IF m.compstat = "ON"
	SET COMPATIBLE ON
ENDIF
