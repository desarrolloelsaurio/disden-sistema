*
FUNCTION _7kp0ou1h3     &&  m.TEXTO2 WHEN
#REGION 1
M.PRIOBJ=_CUROBJ
ON KEY LABEL F2 M.TEXTO2=QUEPOPUP("a Corregir",1,22)
ON KEY LABEL F3  M.TEXTO2=SEEKTECX(20,'MIX','TEXTO1','TEXTO2',TEXTO[1,5],.F.,.F.,2,22)
RETURN EMPTY(M.TEXTO1)

*       ÖÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ·
*       º                                                         º
*       º _7KP0OU1H4           m.TEXTO2 VALID                     º
*       º                                                         º
*       º Function Origin:                                        º
*       º                                                         º
*       º From Platform:       Windows                            º
*       º From Screen:         MIX2TXT,     Record Number:    4   º
*       º Variable:            m.TEXTO2                           º
*       º Called By:           VALID Clause                       º
*       º Object Type:         Field                              º
*       º Snippet Number:      2                                  º
*       º                                                         º
*       ÓÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ½
*
FUNCTION _7kp0ou1h4     &&  m.TEXTO2 VALID
#REGION 1
STORE .F. TO CAMBIO
IF !EMPTY(TEXTO[2,6])
   M.TEXTO2=EVAL(TEXTO[2,6])
ELSE
   M.TEXTO2=TRANSF(M.TEXTO2,TEXTO[2,3])
ENDIF
IF YAESTABA(EVAL(TEXTO[2,4]),'MIX',TEXTO[2,5])
   =YAMIX(MENSAJE[4])
   IF DELE()
      RETURN LLPER("MIX",ALLTRIM(MIX.TEXTO2)+"-"+ALLTRIM(MIX.TEXTO2))
   ENDIF
ELSE
   STORE .T. TO INGRESO
ENDIF
RETURN SGET("MIX")

